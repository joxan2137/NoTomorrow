{
  "name": "notomorrow-backend",
  "version": "0.1.0",
  "private": true,
  "description": "No Tomorrow API: accounts, gym-bro pairing, push, AI photo proxy",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "breached:build": "node scripts/build-breached-list.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@parse/node-apn": "^8.1.0",
    "argon2": "^0.45.1",
    "hono": "^4.13.5",
    "jose": "^6.2.11",
    "pg-boss": "^12.30.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
