# Copy to .env for local development (`npm run dev` loads it via `node --env-file`-style tooling
# such as `set -a; source .env; set +a`). On Fly these are `fly secrets set` values.

# --- required ---------------------------------------------------------------
PORT=8080
DATABASE_URL=postgres://notomorrow:notomorrow@localhost:5432/notomorrow
# HS256 key for 15-minute access tokens (>= 32 chars). `openssl rand -base64 48`
JWT_SECRET=
# Mixed into refresh-token hashes (>= 16 chars). `openssl rand -base64 32`
REFRESH_PEPPER=
# 32 random bytes, base64 — AES-256-GCM key for stored Apple refresh tokens. `openssl rand -base64 32`
TOKEN_ENC_KEY=

# --- optional ---------------------------------------------------------------
LOG_LEVEL=info
# Set to false to boot without the pg-boss scheduler (e.g. a second dev instance).
JOBS_ENABLED=true

# Sign in with Apple (all four or none). `base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'`
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_P8_B64=

# Google Sign-In: comma-separated iOS client ids accepted as `aud`.
GOOGLE_CLIENT_IDS=

# APNs token auth (all four or none). `base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'`
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_P8_B64=
APNS_TOPIC=
APNS_PRODUCTION=false

# Gemini food-photo proxy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_DAILY_LIMIT=30
