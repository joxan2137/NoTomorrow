      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your gym days show up on the calendar and your bro sees the same schedule."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni treningowe trafiają do kalendarza, a kolega widzi ten sam grafik."
