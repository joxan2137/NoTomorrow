    "onboarding.tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Train today. Track everything.\nKeep your bro honest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jutra. Jest dzisiaj.\nTrenuj, zapisuj, pilnuj kolegi."
          }
        }
      }
    },
    "onboarding.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workouts, calories, progress and a shared schedule with the one guy who'll notice if you skip."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treningi, kalorie, postępy i wspólny grafik z jedynym gościem, który zauważy, że cię nie było."
          }
        }
      }
    },
    "onboarding.haveCode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got a code from your bro?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz już kod od kolegi?"
          }
        }
      }
    },
