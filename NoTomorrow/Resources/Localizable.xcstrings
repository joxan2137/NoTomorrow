    "store.error.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Tomorrow can't open the workouts, meals and everything else saved on this phone. Nothing has been deleted. Try again, or save a copy of the data first."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "No Tomorrow nie może otworzyć treningów, posiłków i reszty danych zapisanych na tym telefonie. Nic nie zostało usunięte. Spróbuj ponownie albo najpierw zapisz kopię danych."
          }
        }
      }
    },
    "store.error.retry": {
