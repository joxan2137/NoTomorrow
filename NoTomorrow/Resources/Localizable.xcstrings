    "onboarding.you.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just enough to set your calories. Everything can be changed later in Settings."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyle, żeby ustawić kalorie. Wszystko zmienisz później w ustawieniach."
          }
        }
      }
    },
    "onboarding.schedule.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
