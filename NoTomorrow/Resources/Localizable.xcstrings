      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this photo to %@?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłać to zdjęcie do %@?"
          }
        }
      }
    },
    "fuel.ai.consent.body": {
      "comment": "%@ = provider name (Google / Anthropic).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo (without location or other metadata), the meal details you typed, the meal slot and your language leave your phone and go to %@ to estimate the food. Nothing else is sent. You can change the provider in Settings."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie (bez lokalizacji i innych metadanych), wpisane szczegóły posiłku, pora posiłku i język opuszczają telefon i trafiają do %@, żeby oszacować jedzenie. Nic więcej nie jest wysyłane. Dostawcę zmienisz w ustawieniach."
          }
        }
      }
    },
    "fuel.ai.consent.accept": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send photo"
