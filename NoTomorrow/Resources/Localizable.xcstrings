    "timer.exactAlarm.message": {
      "comment": "Android only. Body of the exact-alarm prompt. 'Exact timers' matches the Android Settings row of the same name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the phone locked, Android can hold the alert back by a minute or more. Allow notifications and exact timers so it goes off the moment your rest ends."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy telefon jest zablokowany, Android może opóźnić alert o minutę lub dłużej. Zezwól na powiadomienia i dokładne minutniki, żeby odezwał się dokładnie wtedy, gdy kończy się przerwa."
          }
        }
      }
    },
    "timer.exactAlarm.allow": {
      "comment": "Android only. Opens the system permission for notifications or exact alarms.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól"
          }
        }
      }
    },
    "timer.exactAlarm.notNow": {
