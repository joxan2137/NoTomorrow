<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Rest-timer Live Update promotion (API 36+, progressive enhancement only). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Deliberately NOT declared: USE_EXACT_ALARM (Play restricts it to alarm/timer/calendar
         apps) and every media-storage permission. -->

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Health Connect (research §6.4) -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".NoTomorrowApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:forceDarkAllowed="false"
        android:theme="@style/Theme.NoTomorrow.Splash"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="locale|layoutDirection|orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NoTomorrow.Splash"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Per-app language on API 32 and below (research §6.9). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="false" />
        </service>

        <!-- Health Connect permissions rationale — Android 13 and below. -->
        <activity
            android:name=".feature.health.PermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.NoTomorrow">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect permissions rationale — Android 14+. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".feature.health.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- CSV export / share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Rest-timer alarm + notification actions (+15 / Skip). Never trampolined
             through an Activity: Android 12 blocks notification-action trampolines. -->
        <receiver
            android:name=".rest.RestTimerReceiver"
            android:exported="false" />

        <!-- Re-arms a still-pending rest after a reboot; iOS gets this for free. -->
        <receiver
            android:name=".rest.BootRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- SCHEDULE_EXACT_ALARM is not pre-granted on 33+ and is dropped by a restore onto
             Android 14; re-arm the pending rest the moment it is granted (research §7.3).
             Sent by the system, so exported="false" is correct. API 31+. -->
        <receiver
            android:name=".rest.ExactAlarmStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets (docs/widgets.md), Jetpack Glance. Exported with the
             APPWIDGET_UPDATE filter, as the launcher binds them. -->
        <receiver
            android:name=".widget.QuickLogWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_fuel_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_log_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.FuelCalendarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_history_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fuel_calendar_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.WeekWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.BreakTimerWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_rest_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/break_timer_widget_info" />
        </receiver>

        <!-- Push (FCM). Inert until android/app/google-services.json exists. -->
        <service
            android:name=".push.NtMessagingService"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Defaults for any notification the FCM SDK renders itself (a payload that carries a
             `notification` block while the app is backgrounded); the app-drawn ones in
             PushNotifier use the same icon and colour. The channel id must stay equal to
             NtChannels.HEADS_UPS — manifest meta-data cannot reference a Kotlin const. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_monochrome" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/nt_ember" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="nt.headsup" />

    </application>
</manifest>
