    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Back figure's head: full disc, r 2.9 at (6.28, 8.6). -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M6.28,5.70 C7.88,5.70 9.18,7.00 9.18,8.60 C9.18,10.20 7.88,11.50 6.28,11.50 C4.68,11.50 3.38,10.20 3.38,8.60 C3.38,7.00 4.68,5.70 6.28,5.70 Z" />
    <!-- Back figure's shoulders: the half-ellipse (6.28, 19.28) rx 5.28 ry 6.36,
         cut at (10.232, 15.062) — where it meets the front dome grown by the
         hairline (rx 7.36 ry 6.72) — then following that offset down to y 19.28. -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M1.00,19.28 A5.28,6.36 0 0 1 10.232,15.062 A7.36,6.72 0 0 0 8.60,19.28 Z" />
