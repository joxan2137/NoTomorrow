<?xml version="1.0" encoding="utf-8"?>
<!-- No Tomorrow icon set. Hand-authored 24dp vectors, original geometry drawn
     to read like the SF glyph. Never traced from SF Symbols.

     `target` is a bullseye, not a reticle: two concentric rings and a solid
     centre dot, no tick marks. The proportions come off the iOS capture
     (design/parity/ios/08-fuel.png, 13 pt semibold → a 40 x 40 px ink box):

       outer ring   outer Ø 40 px, stroke 4.5 px  →  Ø 24.0, stroke 2.7
       inner ring   outer Ø 24 px, stroke 4.0 px  →  Ø 14.4, stroke 2.4
       centre dot   Ø 9 px                        →  Ø 5.4

     The ink fills the viewport edge to edge, so the drawn box *is* the ink box;
     `NtIcons.Target.glyphScale` shrinks that box to the SF ink metric. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Outer ring: centreline r = 12 − 2.7/2 = 10.65, so the stroke's outer
         edge lands exactly on the viewport bounds. -->
    <path android:strokeColor="#FFFFFFFF" android:fillColor="#00000000" android:strokeWidth="2.7"
        android:pathData="M12,1.35 A10.65,10.65 0 1 1 12,22.65 A10.65,10.65 0 1 1 12,1.35 Z" />
    <!-- Inner ring: centreline r = 7.2 − 2.4/2 = 6.0. -->
    <path android:strokeColor="#FFFFFFFF" android:fillColor="#00000000" android:strokeWidth="2.4"
        android:pathData="M12,6 A6,6 0 1 1 12,18 A6,6 0 1 1 12,6 Z" />
    <!-- Centre dot: r = 2.7. -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M12,9.3 A2.7,2.7 0 1 1 12,14.7 A2.7,2.7 0 1 1 12,9.3 Z" />
</vector>
