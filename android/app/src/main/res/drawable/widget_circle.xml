<?xml version="1.0" encoding="utf-8"?>
<!-- The Quick log row's trailing circle behind its + / check: the capsule's surface, round. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="@color/nt_surface3" android:endColor="@color/nt_surface2" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="@color/nt_widget_edge" />
        </shape>
    </item>
</layer-list>
