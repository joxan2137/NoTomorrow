<?xml version="1.0" encoding="utf-8"?>
<!-- Widget button: a `surface2` capsule with a hairline top light (docs/widgets.md, "Look"). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/nt_surface3" android:endColor="@color/nt_surface2" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/nt_widget_edge" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
