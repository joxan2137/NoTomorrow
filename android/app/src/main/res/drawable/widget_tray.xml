<?xml version="1.0" encoding="utf-8"?>
<!-- A recessed tray inside a widget (the Gym week strip): a faint white fill with a hairline edge,
     so the row of days reads as one object on the surface (docs/widgets.md, "Look"). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nt_widget_tray" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/nt_widget_edge" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
