<?xml version="1.0" encoding="utf-8"?>
<!-- A stat tile inside a widget: `surface` at low opacity, rounded, hairline edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nt_widget_tile" />
    <stroke android:width="1dp" android:color="@color/nt_widget_edge" />
    <corners android:radius="14dp" />
</shape>
