        android:pathData="M12,7.27 L19.60,14.16 L19.60,19.60 C19.60,20.48 18.88,21.20 18.00,21.20 L6.00,21.20 C5.12,21.20 4.40,20.48 4.40,19.60 L4.40,14.16 Z M9.90,15.60 L14.10,15.60 L14.10,20.10 L9.90,20.10 Z" />
