    <path android:strokeColor="#FFFFFFFF" android:fillColor="#00000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M3.40,12.60 L12,4.80 L20.60,12.60" />
    <path android:strokeColor="#FFFFFFFF" android:fillColor="#00000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M17.80,6.20 L17.80,10.10" />
